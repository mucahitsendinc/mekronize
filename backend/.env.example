APP_URL=https://api.alanadin.com
APP_LOCALE=tr
APP_FALLBACK_LOCALE=tr

LOG_CHANNEL=daily
LOG_LEVEL=warning

# cPanel > MySQL Veritabanları'ndan oluşturulan bilgiler
