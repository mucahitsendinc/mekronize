<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tile" android:layout_width="match_parent" android:layout_height="128dp"
    android:layout_margin="8dp" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
        android:padding="16dp">
        <ImageView android:id="@+id/tileIcon" android:layout_width="44dp" android:layout_height="44dp" android:padding="11dp"
            android:tint="@android:color/white" android:contentDescription="@null" />
        <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />
        <TextView android:id="@+id/tileTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:singleLine="true" android:textColor="@android:color/white" android:textSize="18sp" android:textStyle="bold" />
        <TextView android:id="@+id/tileSub" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:singleLine="true" android:textColor="#CCFFFFFF" android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>
