<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/sheet" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/bg_sheet" android:elevation="16dp" android:clickable="true" android:focusable="true"
    app:behavior_hideable="true" app:behavior_peekHeight="76dp"
    app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

    <!-- Küçük çubuk: kendi kontrolleri ve ilerleme çizgisi var -->
    <FrameLayout android:id="@+id/miniBar" android:layout_width="match_parent" android:layout_height="76dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
            android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="14dp" android:paddingEnd="6dp">
            <ImageView android:id="@+id/miniIcon" android:layout_width="48dp" android:layout_height="48dp"
                android:background="@drawable/bg_icon_tile" android:padding="12dp" android:src="@drawable/ic_music"
                android:tint="@color/accent" android:contentDescription="@null" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginStart="12dp" android:orientation="vertical">
                <TextView android:id="@+id/miniTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:singleLine="true" android:ellipsize="marquee" android:textColor="@color/text"
                    android:textSize="15sp" android:textStyle="bold" />
                <TextView android:id="@+id/miniSub" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:singleLine="true" android:textColor="@color/muted" android:textSize="12sp" />
            </LinearLayout>
            <ImageButton android:id="@+id/miniPrev" style="@style/IconBtn" android:src="@drawable/ic_prev" android:contentDescription="Önceki" />
            <ImageButton android:id="@+id/miniPlay" android:layout_width="46dp" android:layout_height="46dp"
                android:background="@drawable/bg_play" android:src="@drawable/ic_play" android:tint="@android:color/white"
                android:contentDescription="Oynat/Duraklat" />
            <ImageButton android:id="@+id/miniNext" style="@style/IconBtn" android:src="@drawable/ic_next" android:contentDescription="Sonraki" />
        </LinearLayout>
        <ProgressBar android:id="@+id/miniProgress" style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent" android:layout_height="3dp" android:layout_gravity="bottom"
            android:max="1000" android:progressDrawable="@drawable/seek_progress" />
    </FrameLayout>

    <!-- Büyük oynatıcı -->
    <LinearLayout android:id="@+id/full" android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:alpha="0" android:visibility="invisible"
        android:paddingStart="24dp" android:paddingEnd="24dp" android:paddingBottom="16dp">

        <FrameLayout android:id="@+id/topBar" android:layout_width="match_parent" android:layout_height="56dp">
            <ImageButton android:id="@+id/collapse" style="@style/IconBtn" android:layout_gravity="start|center_vertical"
                android:layout_marginStart="-12dp" android:src="@drawable/ic_chevron_down" android:contentDescription="Küçült" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center"
                android:text="ŞİMDİ ÇALIYOR" android:textColor="@color/muted" android:textSize="12sp"
                android:textStyle="bold" android:letterSpacing="0.12" />
            <ImageButton android:id="@+id/fullscreen" style="@style/IconBtn" android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="-12dp" android:src="@drawable/ic_fullscreen" android:contentDescription="Tam ekran"
                android:visibility="gone" />
        </FrameLayout>

        <FrameLayout android:id="@+id/stage" android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:layout_marginTop="8dp" android:layout_marginBottom="8dp">
            <ImageView android:id="@+id/art" android:layout_width="match_parent" android:layout_height="match_parent"
                android:background="@drawable/bg_art" android:padding="96dp" android:src="@drawable/ic_music"
                android:tint="#CCFFFFFF" android:contentDescription="@null" />
            <androidx.media3.ui.PlayerView android:id="@+id/video" android:layout_width="match_parent" android:layout_height="match_parent"
                android:visibility="gone" app:use_controller="false" app:resize_mode="fit" android:background="@android:color/black"
                app:shutter_background_color="@android:color/black" />
        </FrameLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
            android:gravity="center_vertical">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/fullTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:maxLines="2" android:ellipsize="end" android:textColor="@color/text" android:textSize="22sp" android:textStyle="bold" />
                <TextView android:id="@+id/fullSub" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="2dp" android:singleLine="true" android:textColor="@color/muted" android:textSize="14sp" />
            </LinearLayout>
            <ImageButton android:id="@+id/heart" style="@style/IconBtn" android:src="@drawable/ic_heart_outline"
                android:contentDescription="Favori" />
        </LinearLayout>

        <LinearLayout android:id="@+id/ctrlGroup" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <SeekBar android:id="@+id/seek" android:layout_width="match_parent" android:layout_height="40dp"
            android:layout_marginStart="-12dp" android:layout_marginEnd="-12dp" android:max="1000"
            android:progressDrawable="@drawable/seek_progress" android:thumb="@drawable/seek_thumb" android:splitTrack="false" />
        <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:id="@+id/pos" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="0:00" android:textColor="@color/muted" android:textSize="12sp" />
            <TextView android:id="@+id/dur" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="end" android:text="0:00" android:textColor="@color/muted" android:textSize="12sp" />
        </FrameLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
            android:orientation="horizontal" android:gravity="center_vertical">
            <ImageButton android:id="@+id/shuffle" style="@style/IconBtn" android:layout_weight="1" android:layout_width="0dp"
                android:src="@drawable/ic_shuffle" android:contentDescription="Karışık" />
            <ImageButton android:id="@+id/prev" style="@style/IconBtn" android:layout_weight="1" android:layout_width="0dp"
                android:layout_height="56dp" android:src="@drawable/ic_prev" android:contentDescription="Önceki" />
            <ImageButton android:id="@+id/play" android:layout_width="72dp" android:layout_height="72dp"
                android:background="@drawable/bg_play" android:src="@drawable/ic_play" android:tint="@android:color/white"
                android:contentDescription="Oynat/Duraklat" />
            <ImageButton android:id="@+id/next" style="@style/IconBtn" android:layout_weight="1" android:layout_width="0dp"
                android:layout_height="56dp" android:src="@drawable/ic_next" android:contentDescription="Sonraki" />
            <ImageButton android:id="@+id/repeat" style="@style/IconBtn" android:layout_weight="1" android:layout_width="0dp"
                android:src="@drawable/ic_repeat" android:contentDescription="Tekrar" />
        </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
