<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mini" android:layout_width="match_parent" android:layout_height="64dp"
    android:orientation="horizontal" android:gravity="center_vertical" android:background="@color/surface"
    android:paddingStart="12dp" android:paddingEnd="4dp" android:visibility="gone">
    <ImageView android:id="@+id/miniIcon" android:layout_width="28dp" android:layout_height="28dp"
        android:src="@drawable/ic_music" android:tint="@color/accent" android:contentDescription="@null" />
    <TextView android:id="@+id/miniTitle" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:layout_marginStart="12dp" android:singleLine="true" android:ellipsize="end"
        android:textColor="@color/text" android:textSize="15sp" />
    <ImageButton android:id="@+id/miniShuffle" style="@style/MiniBtn" android:src="@drawable/ic_shuffle" android:contentDescription="Karışık" />
    <ImageButton android:id="@+id/miniPrev" style="@style/MiniBtn" android:src="@drawable/ic_prev" android:contentDescription="Önceki" />
    <ImageButton android:id="@+id/miniPlay" style="@style/MiniBtn" android:src="@drawable/ic_play" android:contentDescription="Oynat/Duraklat" />
    <ImageButton android:id="@+id/miniNext" style="@style/MiniBtn" android:src="@drawable/ic_next" android:contentDescription="Sonraki" />
</LinearLayout>
